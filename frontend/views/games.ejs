<section class="games-grid">
  <% specialCards.forEach(function(card) { if (!isGameVisible(card.flag)) return; %>
    <article class="card game-card">
      <a class="game-cover" href="<%= card.href %>" target="<%= card.href.startsWith('http') ? '_blank' : '_self' %>" rel="<%= card.href.startsWith('http') ? 'noopener noreferrer' : '' %>">
        <img src="<%= card.image %>" alt="<%= card.name %> görseli" loading="lazy" />
      </a>
      <div class="game-card-body">
        <p class="eyebrow"><%= card.eyebrow %></p>
        <h2><%= card.name %></h2>
        <p><%= card.description %></p>
        <a class="btn alt" href="<%= card.href %>" target="<%= card.href.startsWith('http') ? '_blank' : '_self' %>" rel="<%= card.href.startsWith('http') ? 'noopener noreferrer' : '' %>"><%= card.buttonText %></a>
      </div>
    </article>
  <% }) %>

  <% boardGames.forEach(function(game) { if (!isGameVisible(game.flag)) return; %>
    <article class="card game-card">
      <a class="game-cover" href="<%= game.href %>">
        <img src="/public/images/<%= game.slug %>.svg" alt="<%= game.name %> oyun görseli" loading="lazy" />
      </a>
      <div class="game-card-body">
        <p class="eyebrow">Online Masa Oyunu</p>
        <h2><%= game.name %></h2>
        <p><%= game.description %> <%= game.playText %></p>
        <a class="btn alt" href="<%= game.href %>"><%= game.name %> Oyna</a>
      </div>
    </article>
  <% }) %>
</section>

<section class="card compact-top">
  <div class="inline-actions">
    <a class="btn small alt" href="/">Ana Sayfaya Dön</a>
  </div>
</section>

